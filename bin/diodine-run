#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 César Henrique Policarpo de Melo
# diodine-run -- launch one disposable analysis VM.
#
# The QEMU command line built here IS the security policy. Every device the
# guest can see is listed explicitly; -nodefaults means nothing else is
# attached implicitly. Read the ARGS array below and you have read the guest's
# entire hardware attack surface.
#
# Ordering matters and is deliberate:
#   1. The launcher creates the FIFO pair, then starts the receiver, which
#      opens the outbound FIFO O_RDONLY and holds it. The reader must be in
#      place before QEMU opens the write end, or QEMU's non-blocking open
#      fails with ENXIO (per FS-002/OUT-001).
#   2. QEMU starts second and writes into that FIFO, inside a cgroup scope
#      with hard memory/CPU/pid caps.
#   3. A wall-clock deadline destroys the VM regardless of guest cooperation.
#   4. Everything per-run is shredded on exit, on every path including signals.
#
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
BASE="$ROOT/image/base"

# ------------------------------------------------------------------ defaults --
MEM_MB=1024
CPUS=1
TIMEOUT=180
PAYLOAD_TIMEOUT=120
MAX_TOTAL=$((256 * 1024 * 1024))
MAX_ARTIFACT=$((64 * 1024 * 1024))
MAX_FILES=64
CPU_QUOTA=100          # percent of ONE core
PAYLOAD=""
SAMPLE=""
ALLOW_RNG=0
KEEP_RUNDIR=0
ALLOW_UNCONFINED=0
QUARANTINE_WARN_MB=5000
RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"

say() { printf '\033[1m[diodine]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[diodine] error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<USAGE
usage: diodine-run [options]

  --payload FILE        script to run inside the guest (default: built-in probe)
  --sample FILE         file to place at /diodine/sample/ inside the guest
  --mem MB              guest memory cap            (default $MEM_MB)
  --cpus N              guest vcpus                 (default $CPUS)
  --cpu-quota PCT       host CPU cap, % of one core (default $CPU_QUOTA)
  --timeout SEC         wall-clock budget for the run (default $TIMEOUT)
  --payload-timeout SEC budget for the payload itself (default $PAYLOAD_TIMEOUT)
  --max-total BYTES     total export cap            (default $MAX_TOTAL)
  --max-artifact BYTES  per-artifact export cap     (default $MAX_ARTIFACT)
  --max-files N         artifact count cap          (default $MAX_FILES)
  --allow-rng           expose virtio-rng to the guest (DEV-005: opt-in, this
                        is a host-to-guest data path and is off by default)
  --allow-unconfined    run even if the AppArmor profile is not loaded
                        (VMM-002: without this a run REFUSES to start
                        unconfined. Load the profile once with
                        sudo policy/apparmor/install)
  --quarantine-warn-mb N  warn when cumulative quarantine size exceeds N MB
                        (RES-008, default 5000; 0 warns always). Reports only --
                        nothing here ever deletes quarantined output
  --keep-rundir         do not shred the run directory on exit (debugging)
  -h, --help            this message
USAGE
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case $1 in
        --payload)          PAYLOAD=${2:?}; shift 2 ;;
        --sample)           SAMPLE=${2:?}; shift 2 ;;
        --mem)              MEM_MB=${2:?}; shift 2 ;;
        --cpus)             CPUS=${2:?}; shift 2 ;;
        --cpu-quota)        CPU_QUOTA=${2:?}; shift 2 ;;
        --timeout)          TIMEOUT=${2:?}; shift 2 ;;
        --payload-timeout)  PAYLOAD_TIMEOUT=${2:?}; shift 2 ;;
        --max-total)        MAX_TOTAL=${2:?}; shift 2 ;;
        --max-artifact)     MAX_ARTIFACT=${2:?}; shift 2 ;;
        --max-files)        MAX_FILES=${2:?}; shift 2 ;;
        --allow-rng)        ALLOW_RNG=1; shift ;;
        --allow-unconfined) ALLOW_UNCONFINED=1; shift ;;
        --quarantine-warn-mb) QUARANTINE_WARN_MB="$2"; shift 2 ;;
        --keep-rundir)      KEEP_RUNDIR=1; shift ;;
        -h|--help)          usage 0 ;;
        *)                  echo "unknown option: $1" >&2; usage 1 ;;
    esac
done

command -v qemu-system-x86_64 >/dev/null || die "qemu-system-x86_64 not found"
[ -r "$BASE/vmlinuz" ]   || die "no base kernel; run image/build-base-image first"
[ -r "$BASE/initramfs" ] || die "no base initramfs; run image/build-base-image first"
[ -r /dev/kvm ] && [ -w /dev/kvm ] || die "/dev/kvm not accessible to $(id -un)"
[ "$(id -u)" -ne 0 ] || die "refusing to run as root (TCB-001)"

# VMM-002, decided here with the other preconditions and before anything has a
# side effect. Refusing after the receiver is up and a quarantine directory
# exists leaves debris behind for a run that never happened.
#
# Detection is by attempting the transition, not by reading the profile set.
# `aa-status --profiled` and /sys/kernel/security/apparmor/profiles are both
# root-only and TCB-001 forbids this launcher root, so a readability test reports
# "not loaded" however the profile is installed -- which made this claim
# unsatisfiable rather than merely unmet. aa-exec answers it unprivileged.
# QUAR-001. The exclusion markers in quarantine/ are advisory and always will be
# -- Diodine cannot make a third-party agent honour them. What it CAN do is say
# whether any such agent is running right now, which turns a silent weakness into
# a visible one. This warns and never blocks: these are host-wide desktop
# services, and refusing to run on any machine with a file indexer would make the
# tool unusable without making the quarantine any safer.
#
# Matched on /proc/<pid>/comm, never on cmdline. A cmdline match finds the
# process doing the matching, whose own arguments contain every name in the list
# -- that mistake reported all six of these as running on a host with none of
# them. comm truncates at 15 characters, so the patterns are compared as prefixes.
QUAR_CONSUMERS=""
quar_scan() {
    local watch="tracker-miner tracker-extract tracker-store baloo_file
                 baloop thumbnail tumblerd clamd freshclam clamonacc updatedb
                 mandb duplicati restic borgbackup deja-dup rsnapshot"
    local d comm w found=""
    for d in /proc/[0-9]*; do
        comm=$(cat "$d/comm" 2>/dev/null) || continue
        for w in $watch; do
            case "$comm" in
                "$(printf '%.15s' "$w")"*)
                    case " $found " in *" $comm "*) ;; *) found="$found $comm" ;; esac
                    ;;
            esac
        done
    done
    printf '%s' "${found# }"
}
QUAR_CONSUMERS=$(quar_scan)
if [ -n "$QUAR_CONSUMERS" ]; then
    say "QUAR-001 WARNING: these read files automatically and ignore the"
    say "                  advisory exclusion markers unless configured:"
    say "                    $QUAR_CONSUMERS"
    say "                  configure them to skip $ROOT/quarantine out of band."
fi

APPARMOR_CONFINE=0
if command -v aa-exec >/dev/null 2>&1 \
   && aa-exec -p diodine-qemu -- /bin/true 2>/dev/null; then
    APPARMOR_CONFINE=1
elif [ "$ALLOW_UNCONFINED" -eq 0 ]; then
    # Fail closed. Degrading quietly was the wrong default: the warning went to
    # stdout, scrolled past, and nothing on disk recorded that a run had no MAC
    # confinement -- which is how eight consecutive runs went unconfined here
    # without anyone noticing. Waiving it now has to be said on the command line.
    say "REFUSING TO RUN: AppArmor profile diodine-qemu is not loaded (VMM-002)"
    say "  load it once with:  sudo policy/apparmor/install"
    say "  or waive it with:   --allow-unconfined  (recorded in RUN.json)"
    exit 2
fi

# ------------------------------------------------- MAC denial visibility (W1) --
# AUD-004. A loaded profile that refuses something can cost nothing visible: the
# NUMA denial fired on EVERY confined run while 26/26 checks passed twice, and
# nothing on disk recorded it. A run has to be able to say whether its own
# confinement refused anything.
#
# The evidence lives in the kernel audit log, which TCB-001 forbids this launcher
# the privilege to read. So the operator grants journal access once, out of band
# (policy/apparmor/install prints the step), and this stays unprivileged. When the
# grant is absent the run still happens and RECORDS that it was blind, the way
# QUAR-001 warns rather than refusing -- Diodine cannot fix a host-wide condition
# and refusing every run on an unprovisioned host would not make it any safer.
# tests/run-checks is what refuses to be blind.
DENIAL_ANCHOR=none
DENIAL_CURSOR=""
DENIAL_SINCE=0
DENIALS_OK=0
DENIALS_WHY=""

# Availability by LIVE READ, never by group membership. `id -Gn | grep
# systemd-journal` reports success in a fresh login session and failure in a stale
# one -- supplementary groups are fixed at login, so usermod does not change any
# running process -- and reports success on a host whose journal ACL has been
# stripped. Detection by attempted use is the same argument VMM-002 rests on when
# it probes with aa-exec instead of reading the profile set.
#
# This must test OUTPUT, never exit status: journalctl exits 0 while printing
# "-- No entries --". Phase 1 already shipped that exact bug in the other
# direction -- a dmesg pipeline that returned tail's status and reported "no
# denials" from a log it never read.
# Two sources, preferred in order. The FEED is the one policy/apparmor/install
# provisions: a confined DynamicUser service holding the journal grant and
# publishing only this profile's denials to tmpfs, so no login needs journal
# access. Direct journal reading stays as the fallback for a host where the
# operator granted group membership instead, or has no systemd.
DENIAL_SOURCE=none
DENIAL_FEED=/run/diodine/denials.log

# A feed that is INSTALLED BUT DEAD is the dangerous case: the file exists, reads
# clean, and every run reports zero denials forever. So liveness is required, not
# merely presence -- "nothing happened" and "nothing was watching" must not read
# alike, the same distinction AUD-001 draws between unknown and unconfined.
feed_probe() {
    [ -r "$DENIAL_FEED" ] || return 1
    command -v systemctl >/dev/null 2>&1 || {
        DENIALS_WHY="denial feed present but systemctl is absent to confirm it is running"
        return 1; }
    if ! systemctl is-active --quiet diodine-denials.service 2>/dev/null; then
        DENIALS_WHY="denial feed file exists but diodine-denials.service is not running (stale file)"
        return 1
    fi
    return 0
}

journal_probe() {
    command -v journalctl >/dev/null 2>&1 || {
        DENIALS_WHY="journalctl not present on this host"; return 1; }
    if [ -z "$(journalctl -q -k -n1 --no-pager -o short 2>/dev/null \
               | grep -vE '^--|^[[:space:]]*$' | head -1)" ]; then
        DENIALS_WHY="journal kernel read unavailable (live probe returned no records)"
        return 1
    fi
    return 0
}

capture_denial_anchor() {
    # Epoch, not a formatted date: --since "@<epoch>" is unambiguous, where a
    # formatted string is read as local time and would skew by the UTC offset.
    # One-second granularity over-includes rather than under-includes, which is
    # the safe direction for a denial count.
    DENIAL_SINCE=$(date +%s)
    # --show-cursor works unprivileged even when -k returns nothing, so the anchor
    # survives an unprovisioned host; only the READ is gated.
    DENIAL_CURSOR=$(journalctl -q -n0 --show-cursor 2>/dev/null \
                    | sed -n 's/^-- cursor: //p' | head -1)
    if [ -n "$DENIAL_CURSOR" ]; then DENIAL_ANCHOR=cursor
    else DENIAL_ANCHOR=timestamp; fi
}

# Kernel records since the anchor. AppArmor denials arrive as transport=kernel.
denial_window() {
    if [ "$DENIAL_SOURCE" = feed ]; then
        # Each line carries an epoch prefix written by the feed itself, so this
        # needs no date parsing and is locale-proof. >= over > deliberately:
        # one-second granularity should over-include, never under-include.
        awk -v since="$DENIAL_SINCE" '$1 ~ /^[0-9]+$/ && $1 >= since' \
            "$DENIAL_FEED" 2>/dev/null
        return
    fi
    if [ "$DENIAL_ANCHOR" = cursor ]; then
        journalctl -q -k --no-pager -o short --after-cursor "$DENIAL_CURSOR" 2>/dev/null
    else
        journalctl -q -k --no-pager -o short --since "@$DENIAL_SINCE" 2>/dev/null
    fi
}

# journald's rate-limit notice is emitted by journald itself, NOT with
# transport=kernel, so -k would filter out the very record that says the count is
# short. Same window, no -k.
suppression_window() {
    if [ "$DENIAL_SOURCE" = feed ]; then
        # The feed records its own truncation in-band, for the same reason the
        # journal path reports journald's rate-limit notice: a count from a
        # truncated window is a lower bound and must say so.
        awk -v since="$DENIAL_SINCE" '$1 ~ /^[0-9]+$/ && $1 >= since && /TRUNCATED/ \
            { print "Suppressed " $0 " messages" }' "$DENIAL_FEED" 2>/dev/null
        return
    fi
    if [ "$DENIAL_ANCHOR" = cursor ]; then
        journalctl -q --no-pager -o short --after-cursor "$DENIAL_CURSOR" 2>/dev/null
    else
        journalctl -q --no-pager -o short --since "@$DENIAL_SINCE" 2>/dev/null
    fi
}

json_str() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' -e 's/\t/ /g'; }

# Appends the denials block to a RUN.json the prober has already written. It has
# to be post-run -- record_launch_state races the VM by design and finishes while
# the guest is still alive, so it cannot know what the run went on to be denied.
DENIAL_RECORD_CAP=50
record_denials() {
    # Split deliberately: bash expands every word of a `local` command BEFORE
    # assigning any of them, so "$out.denials" on this line would expand `out`
    # while it is still unbound -- fatal under set -u, and NOT catchable by the
    # `|| say ...` at the call site, which aborted a whole run mid-cleanup.
    local out="$1"
    local n=0 supp=false raw=""
    local tmp="$out.denials"

    if [ "$DENIALS_OK" -eq 0 ]; then
        DENIAL_JSON=$(printf '  "denials": {\n    "checked": false,\n    "source": "%s",\n    "anchor": "%s",\n    "reason": "%s"\n  }' \
                      "$DENIAL_SOURCE" "$DENIAL_ANCHOR" \
                      "$(printf '%s' "$DENIALS_WHY" | json_str)")
    else
        # Match both markers. profile= is a prefix test because a child profile
        # appears as diodine-qemu//something.
        raw=$(denial_window | grep 'apparmor="DENIED"' | grep 'profile="diodine-qemu' || true)
        n=$(printf '%s' "$raw" | grep -c . || true)
        if suppression_window | grep -qE 'Suppressed [0-9]+ messages'; then
            supp=true
        fi
        local recs=""
        if [ "$n" -gt 0 ]; then
            recs=$(printf '%s' "$raw" | head -n "$DENIAL_RECORD_CAP" | json_str \
                   | sed -e 's/^/      "/' -e 's/$/",/' | sed '$ s/,$//')
            recs=$(printf '\n%s\n    ' "$recs")
        fi
        DENIAL_JSON=$(printf '  "denials": {\n    "checked": true,\n    "source": "%s",\n    "anchor": "%s",\n    "count": %s,\n    "suppressed": %s,\n    "recorded": %s,\n    "records": [%s]\n  }' \
                      "$DENIAL_SOURCE" "$DENIAL_ANCHOR" "$n" "$supp" \
                      "$([ "$n" -gt "$DENIAL_RECORD_CAP" ] && echo "$DENIAL_RECORD_CAP" || echo "$n")" \
                      "$recs")
    fi

    # Splice in textually rather than reserialising, so the record keeps the shape
    # record_launch_state authored. Temp + mv + chmod is the same atomic pattern
    # the prober and the receiver's manifest already use.
    if [ -r "$out" ]; then
        head -n -1 "$out" > "$tmp" 2>/dev/null || return 1
        sed -i '$ s/$/,/' "$tmp"
        printf '%s\n}\n' "$DENIAL_JSON" >> "$tmp"
    else
        printf '{\n  "run_id": "%s",\n  "observed": false,\n%s\n}\n' \
               "$RUN_ID" "$DENIAL_JSON" > "$tmp"
    fi
    chmod 0600 "$out" 2>/dev/null || true
    mv "$tmp" "$out" && chmod 0400 "$out"
}

# Probed here, with the other preconditions, so an operator who has not granted
# journal access learns it before the run rather than from RUN.json afterwards.
if feed_probe; then
    DENIALS_OK=1; DENIAL_SOURCE=feed
elif journal_probe; then
    DENIALS_OK=1; DENIAL_SOURCE=journal
else
    say "AUD-004 WARNING: cannot read AppArmor denials for this run"
    say "                 $DENIALS_WHY"
    say "                 the run will proceed and record denials.checked=false."
    say "                 install the denial feed once (no group, no root daemon):"
    say "                     sudo policy/apparmor/install"
    say "                 it runs a confined service that publishes only this"
    say "                 profile's denials to /run/diodine/denials.log."
fi

# RES-007 (W3). The console goes straight to a host file, outside every export
# cap, bounded by the wall clock and the emulated 16550's ~50 KB/s ceiling --
# about 9 MB at the default 180s budget. That is a decided trade-off rather than
# a gap: -chardev file never blocks QEMU, so the console carries no backpressure
# and therefore no OUT-002-style timing channel, where a bounded writer would
# give it both. The trade only holds while the budget is short, so say so when
# it stops being.
if [ "$TIMEOUT" -gt 3600 ]; then
    say "RES-007 NOTE: a ${TIMEOUT}s budget allows roughly $((TIMEOUT * 50 / 1024)) MB of console"
    say "              output, which no export cap covers. The console is uncapped"
    say "              by design; at this budget its size stops being negligible."
fi

# -------------------------------------------------------------- run scaffold --
RUNBASE="${XDG_RUNTIME_DIR:-/tmp}/diodine"
mkdir -p "$RUNBASE"; chmod 0700 "$RUNBASE"
RUNDIR="$(mktemp -d "$RUNBASE/r.XXXXXX")"

# OUT-001. QEMU's pipe chardev uses a FIFO pair: it WRITES guest output to
# <path>.out and READS host input from <path>.in. Both must exist for QEMU to
# start, but nothing in Diodine ever opens .in for writing -- so the inbound
# FIFO has no writer and the guest's reads on it see EOF forever. The
# directionality is a property of which descriptors exist, not of anyone's
# good behaviour, and it survives a compromised receiver.
PIPE="$RUNDIR/iv"
mkfifo -m 0600 "$PIPE.out" "$PIPE.in"

QUARANTINE="$ROOT/quarantine/$RUN_ID"
mkdir -p "$QUARANTINE"; chmod 0700 "$QUARANTINE"

RECV_PID=""; QEMU_PID=""; PROBE_PID=""
cleanup() {
    local rc=$?
    [ -n "$QEMU_PID" ] && kill -KILL "$QEMU_PID" 2>/dev/null || true
    [ -n "$RECV_PID" ] && kill -TERM "$RECV_PID" 2>/dev/null || true
    [ -n "$PROBE_PID" ] && kill -TERM "$PROBE_PID" 2>/dev/null || true
    if [ "$KEEP_RUNDIR" -eq 0 ]; then
        # The per-run initramfs carries the sample. Shred it rather than
        # unlinking, so a sample does not linger in freed blocks.
        find "$RUNDIR" -type f -exec shred -u -n1 {} + 2>/dev/null || true
        rm -rf "$RUNDIR" 2>/dev/null || true
    else
        say "run directory kept: $RUNDIR"
    fi
    exit $rc
}
trap cleanup EXIT INT TERM

# ------------------------------------------------------- per-run payload cpio --
# The base initramfs is never rewritten (FS-003). Per-run files ride in as a
# second cpio archive concatenated onto it -- the kernel unpacks concatenated
# archives in order, so later entries win.
OVERLAY="$RUNDIR/overlay"
mkdir -p "$OVERLAY/diodine/payload" "$OVERLAY/diodine/sample"

if [ -n "$PAYLOAD" ]; then
    [ -r "$PAYLOAD" ] || die "payload not readable: $PAYLOAD"
    install -m 0755 "$PAYLOAD" "$OVERLAY/diodine/payload/run"
    say "payload: $PAYLOAD"
else
    say "payload: built-in environment probe"
fi

if [ -n "$SAMPLE" ]; then
    [ -r "$SAMPLE" ] || die "sample not readable: $SAMPLE"
    install -m 0444 "$SAMPLE" "$OVERLAY/diodine/sample/$(basename "$SAMPLE")"
    say "sample: $SAMPLE -> /diodine/sample/$(basename "$SAMPLE")"
fi

( cd "$OVERLAY" && find . -print0 | sort -z \
    | cpio --null -o -H newc -R 0:0 --quiet ) | gzip > "$RUNDIR/overlay.cpio.gz"
cat "$BASE/initramfs" "$RUNDIR/overlay.cpio.gz" > "$RUNDIR/initrd"

BASE_SHA_BEFORE=$(sha256sum "$BASE/initramfs" | cut -d' ' -f1)

# W5 is deferred (see BACKLOG.md), but the provenance it depends on is not: every
# number this project has measured -- RES-007's ceiling, OUT-002's buffer depth,
# the profile's completeness -- is a property of one kernel and one QEMU. Without
# recording which, a number collected today cannot be attributed to a platform
# later, and the deferral stops being honest.
HOST_KERNEL=$(uname -r 2>/dev/null || echo unknown)
HOST_QEMU=$(qemu-system-x86_64 --version 2>/dev/null \
            | sed -n '1s/^QEMU emulator version //p')
HOST_AA=$(apparmor_parser --version 2>/dev/null | sed -n '1s/.*version //p')
[ -n "$HOST_QEMU" ] || HOST_QEMU=unknown
[ -n "$HOST_AA" ]   || HOST_AA=unknown

# ------------------------------------------------------------------ receiver --
say "starting receiver (quarantine: quarantine/$RUN_ID)"
"$HERE/diodine-receiver" \
    --fifo "$PIPE.out" --outdir "$QUARANTINE" \
    --max-total "$MAX_TOTAL" --max-artifact "$MAX_ARTIFACT" \
    --max-files "$MAX_FILES" --timeout "$TIMEOUT" &
RECV_PID=$!

# The reader must hold the outbound FIFO open before QEMU opens the write end,
# or QEMU's non-blocking open fails with ENXIO.
for _ in $(seq 100); do
    kill -0 "$RECV_PID" 2>/dev/null || die "receiver exited during startup"
    fuser "$PIPE.out" >/dev/null 2>&1 && break
    sleep 0.1
done

# ---------------------------------------------------------------- qemu args --
# Everything the guest can see is on this list. Nothing is implicit.
ARGS=(
    -name "diodine-$RUN_ID"
    -no-user-config                 # ignore system-wide qemu config
    -nodefaults                     # attach NOTHING we do not name below
    -machine q35,accel=kvm
    -cpu host
    -smp "$CPUS"
    -m "$MEM_MB"

    # VMM-001: seccomp, with every escalation class denied.
    -sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny

    # NET-001/NET-002: no NIC exists. There is nothing to route from.
    -nic none

    # DEV-002: no graphics adapter, no display backend.
    -display none
    -vga none

    # No monitor socket, no QMP: nothing that could be used to reconfigure the
    # running VM from inside it.
    -monitor none

    # RAM-only boot. No -drive, no -device virtio-blk: the guest has no block
    # device at all, so FS-003 holds by construction.
    -kernel "$BASE/vmlinuz"
    -initrd "$RUNDIR/initrd"
    -append "console=ttyS0 quiet panic=1 diodine.payload_timeout=$PAYLOAD_TIMEOUT"

    # The output channel. One port, one direction by policy at the far end.
    -device virtio-serial-pci,id=vser0,max_ports=2
    -chardev "pipe,id=ivout,path=$PIPE"
    -device virtserialport,chardev=ivout,bus=vser0.0,name=org.diodine.out

    # Guest console -> a host log file. Read-only to the guest's benefit; the
    # guest cannot read this file back.
    -chardev "file,id=ivcon,path=$QUARANTINE/console.log"
    -serial chardev:ivcon

    -rtc base=utc
    -no-reboot                      # a guest reboot ends the run
)

# DEV-005: virtio-rng is a host-to-guest data path. Opt-in only, and recorded.
if [ "$ALLOW_RNG" -eq 1 ]; then
    say "WARNING: --allow-rng exposes a host-to-guest entropy path (DEV-005)"
    ARGS+=(-object rng-random,id=rng0,filename=/dev/urandom
           -device virtio-rng-pci,rng=rng0)
fi

# VMM-002 was already decided in the precondition block above, which is the only
# place that can refuse before anything has a side effect. All that is left here
# is to act on it.
if [ "$APPARMOR_CONFINE" -eq 1 ]; then
    LAUNCH=(aa-exec -p diodine-qemu -- qemu-system-x86_64)
    say "AppArmor: confining under diodine-qemu (VMM-002)"
else
    LAUNCH=(qemu-system-x86_64)
    say "AppArmor: profile not loaded; proceeding UNCONFINED per --allow-unconfined"
    say "          (VMM-002 waived for this run, and recorded in RUN.json)"
fi

# ------------------------------------------------------- launch-state record --
# A run must be able to say which claims were actually live while it happened.
# Every value here is READ BACK from the live VMM process and its cgroup rather
# than echoed from this script's intent: for eight runs the launcher correctly
# reported "confining under diodine-qemu" while the profile denied qemu's NUMA
# probe on every one of them, and nothing on disk recorded either fact. An
# unconfined run that believed it was confined is precisely what this record
# exists to make visible.
#
# It runs as a short-lived prober so the launch line below stays one
# unconditional statement, and it never fails the run -- a missing record means
# the prober lost the race, which is itself written down as observed=false.
record_launch_state() {
    local out="$1" scope="" qpid="" comm="" i p

    for i in $(seq 400); do
        scope=$(find "/sys/fs/cgroup/user.slice/user-$(id -u).slice" \
                     -maxdepth 4 -type d -name "diodine-$RUN_ID.scope" \
                     2>/dev/null | head -1)
        if [ -n "$scope" ]; then
            for p in $(cat "$scope/cgroup.procs" 2>/dev/null); do
                case "$(cat "/proc/$p/comm" 2>/dev/null)" in
                    qemu-system*) qpid=$p; comm=$(cat "/proc/$p/comm"); break ;;
                esac
            done
            [ -n "$qpid" ] && break
        fi
        sleep 0.05
    done

    local observed=false profile="not observed" seccomp="not observed" uid=null
    if [ -n "$qpid" ] && [ -d "/proc/$qpid" ]; then
        observed=true
        profile=$(tr -d '\000' < "/proc/$qpid/attr/current" 2>/dev/null | tr -d '\n')
        [ -n "$profile" ] || profile="unreadable"
        uid=$(awk '/^Uid:/{print $2}' "/proc/$qpid/status" 2>/dev/null)
        [ -n "$uid" ] || uid=null
        # qemu installs its seccomp filter a short way into startup, so the
        # first sample can legitimately read 0 on a process that is about to be
        # sandboxed. Reading once made VMM-001's verdict a race: one run in six
        # recorded "disabled" while the other five recorded "filter" on the same
        # binary. Wait briefly for the filter to appear, and only report absence
        # after the process has had the chance to install one.
        local mode=0 j
        for j in $(seq 60); do
            mode=$(awk '/^Seccomp:/{print $2}' "/proc/$qpid/status" 2>/dev/null)
            [ -n "$mode" ] || { mode=gone; break; }
            [ "$mode" != 0 ] && break
            sleep 0.05
        done
        case "$mode" in
            0)    seccomp=disabled ;;
            1)    seccomp=strict ;;
            2)    seccomp=filter ;;
            gone) seccomp="not observed (vmm exited during sampling)" ;;
            *)    seccomp=unknown ;;
        esac
    fi

    local confined=false
    case "$profile" in diodine-qemu*) confined=true ;; esac

    local cg_mem="not observed" cg_swap="not observed" cg_cpu="not observed"
    local cg_pids="not observed" cg_io="not observed"
    if [ -n "$scope" ]; then
        cg_mem=$(cat "$scope/memory.max" 2>/dev/null || echo null)
        cg_swap=$(cat "$scope/memory.swap.max" 2>/dev/null || echo null)
        cg_pids=$(cat "$scope/pids.max" 2>/dev/null || echo null)
        cg_cpu=$(cat "$scope/cpu.max" 2>/dev/null || echo "")
        [ -f "$scope/io.max" ] && cg_io=present || cg_io=absent
    fi

    # RES-004 is a known gap: without a delegated io controller there is no
    # io.max to read, and the record says so rather than omitting it.
    {
        printf '{\n'
        printf '  "run_id": "%s",\n' "$RUN_ID"
        printf '  "observed": %s,\n' "$observed"
        printf '  "vmm": {\n'
        printf '    "pid": %s,\n' "${qpid:-null}"
        printf '    "comm": "%s",\n' "$comm"
        printf '    "uid": %s,\n' "$uid"
        printf '    "apparmor_profile": "%s",\n' "$profile"
        printf '    "confined": %s,\n' "$confined"
        printf '    "seccomp": "%s"\n' "$seccomp"
        printf '  },\n'
        printf '  "cgroup": {\n'
        printf '    "scope": "%s",\n' "${scope:-}"
        printf '    "memory_max": "%s",\n' "$cg_mem"
        printf '    "memory_swap_max": "%s",\n' "$cg_swap"
        printf '    "cpu_max": "%s",\n' "$cg_cpu"
        printf '    "pids_max": "%s",\n' "$cg_pids"
        printf '    "io_max": "%s"\n' "$cg_io"
        printf '  },\n'
        printf '  "host": {\n'
        printf '    "kernel": "%s",\n' "$HOST_KERNEL"
        printf '    "qemu": "%s",\n' "$HOST_QEMU"
        printf '    "apparmor_parser": "%s"\n' "$HOST_AA"
        printf '  },\n'
        printf '  "declared": {\n'
        printf '    "mem_mb": %s,\n' "$MEM_MB"
        printf '    "vcpus": %s,\n' "$CPUS"
        printf '    "cpu_quota_pct": %s,\n' "$CPU_QUOTA"
        printf '    "wall_clock_s": %s,\n' "$TIMEOUT"
        printf '    "host_entropy_exposed": %s,\n' "$([ "$ALLOW_RNG" -eq 1 ] && echo true || echo false)"
        printf '    "unconfined_waived": %s,\n' "$([ "$ALLOW_UNCONFINED" -eq 1 ] && echo true || echo false)"
        printf '    "quarantine_consumers_running": "%s"\n' "$QUAR_CONSUMERS"
        printf '  },\n'
        printf '  "policy": {\n'
        if [ "$observed" = true ]; then
            printf '    "VMM-001": "%s",\n' "$([ "$seccomp" = filter ] && echo live || echo "DEGRADED ($seccomp)")"
            printf '    "VMM-002": "%s",\n' "$([ "$confined" = true ] && echo live \
                || { [ "$ALLOW_UNCONFINED" -eq 1 ] \
                     && echo "WAIVED (--allow-unconfined)" \
                     || echo "DEGRADED (unconfined)"; })"
            printf '    "TCB-001": "%s",\n' "$([ "$uid" != 0 ] && echo live || echo "DEGRADED (uid 0)")"
        else
            printf '    "VMM-001": "unknown (vmm not observed)",\n'
            printf '    "VMM-002": "unknown (vmm not observed)",\n'
            printf '    "TCB-001": "unknown (vmm not observed)",\n'
        fi
        # RES-004 is structural now, not a cgroup reading: the guest has no block
        # device, so there is no guest disk I/O to cap. io.max presence is still
        # recorded under "cgroup" above, but it is not what decides this claim.
        printf '    "RES-004": "live (no block device)",\n'
        printf '    "DEV-005": "%s",\n' "$([ "$ALLOW_RNG" -eq 1 ] && echo "DEGRADED (host entropy exposed)" || echo live)"
        printf '    "QUAR-001": "%s"\n' "$([ -n "$QUAR_CONSUMERS" ] \
            && echo "DEGRADED (consumers running)" || echo "advisory (none detected)")"
        printf '  }\n'
        printf '}\n'
    } > "$out.partial" 2>/dev/null && mv "$out.partial" "$out" && chmod 0400 "$out"
}

# ------------------------------------------------------------------- launch --
# RES-001/2/3: hard caps in a transient cgroup scope. MemorySwapMax=0 keeps
# guest RAM off host swap, which matters for disposal hygiene as much as for
# resource safety.
SCOPE=(systemd-run --user --scope --quiet
       --unit "diodine-$RUN_ID"
       -p MemoryMax="${MEM_MB}M"
       -p MemorySwapMax=0
       -p CPUQuota="${CPU_QUOTA}%"
       -p TasksMax=64)

say "launching: ${MEM_MB}MB / ${CPUS} vcpu / ${CPU_QUOTA}% cpu / ${TIMEOUT}s wall clock"

# Anchored as late as possible before QEMU starts, so the window is the run's own.
capture_denial_anchor

record_launch_state "$QUARANTINE/RUN.json" &
PROBE_PID=$!

# OUT-004. QEMU used to inherit this script's stdout and stderr, so its
# diagnostics went to whatever the operator's shell was and nothing on disk
# recorded them -- the same defect VMM-002's comment describes having already
# been fixed once for the launcher's OWN messages. Found by
# tests/enumerate-paths, which is the point of that tool.
#
# Not piped into tee: piping the launch would make QRC the exit status of the
# LAST command in the pipeline rather than the VMM's, and every decision below
# reads QRC. The operator gets the content back explicitly instead, further down.
VMMLOG="$QUARANTINE/vmm.log"
set +e
timeout --kill-after=10s "$TIMEOUT" "${SCOPE[@]}" "${LAUNCH[@]}" "${ARGS[@]}" \
        > "$VMMLOG" 2>&1
QRC=$?
set -e
QEMU_PID=""

case $QRC in
    0)   say "guest exited cleanly" ;;
    124) say "WALL-CLOCK TIMEOUT: guest destroyed at ${TIMEOUT}s (RES-005)" ;;
    137) say "guest killed (SIGKILL)" ;;
    *)   say "qemu exited $QRC" ;;
esac

# Recording is not the same as showing. A failed launch has to reach the operator
# now -- redirecting it to a file they have not been told about would recreate the
# exact invisibility this change exists to remove, one layer down.
if [ -s "$VMMLOG" ]; then
    say "VMM diagnostics: $(wc -c < "$VMMLOG") bytes recorded in vmm.log (OUT-004)"
    if [ "$QRC" -ne 0 ]; then
        head -n 20 "$VMMLOG" | sed 's/^/  | /' >&2
    fi
fi
chmod 0400 "$VMMLOG" 2>/dev/null || true

# A nonzero receiver exit is a normal, meaningful outcome -- an enforced cap
# is a success, not a launcher failure -- so it must not trip `set -e` and
# skip the checks below.
wait "$PROBE_PID" 2>/dev/null || true
PROBE_PID=""
if [ -r "$QUARANTINE/RUN.json" ]; then
    say "launch state recorded: $(sed -n 's/.*"apparmor_profile": "\([^"]*\)".*/\1/p' \
                                        "$QUARANTINE/RUN.json"), seccomp=$(
                                 sed -n 's/.*"seccomp": "\([^"]*\)".*/\1/p' \
                                        "$QUARANTINE/RUN.json")"
else
    say "WARNING: launch state was not recorded for this run"
fi

# AUD-004. QEMU is dead by now -- the timeout above returned -- so the window
# between the anchor and here is exactly this run's. Reading it any earlier would
# race the denials it exists to find.
record_denials "$QUARANTINE/RUN.json" || say "WARNING: could not record denials"
if [ "$DENIALS_OK" -eq 0 ]; then
    say "AUD-004: denial checking was UNAVAILABLE; recorded as checked=false"
else
    DN=$(sed -n 's/.*"count": \([0-9]*\).*/\1/p' "$QUARANTINE/RUN.json" | head -1)
    DS=$(sed -n 's/.*"suppressed": \([a-z]*\).*/\1/p' "$QUARANTINE/RUN.json" | head -1)
    if [ "${DN:-0}" -gt 0 ]; then
        say "AUD-004 WARNING: the confinement profile DENIED ${DN} operation(s) this run."
        say "                 A denial that costs nothing visible is how the NUMA probe"
        say "                 went unnoticed for eight runs. Treat it as a profile bug"
        say "                 until proven otherwise; the records are in RUN.json."
    elif [ "$DS" = true ]; then
        say "AUD-004 WARNING: journald suppressed messages in this run's window, so a"
        say "                 denial count of ${DN:-0} is a LOWER BOUND, not a total."
    else
        say "AUD-004: no MAC denials during this run (checked)"
    fi
fi

RRC=0
wait "$RECV_PID" 2>/dev/null || RRC=$?
RECV_PID=""

# FS-003: prove the base image is byte-identical after the run.
BASE_SHA_AFTER=$(sha256sum "$BASE/initramfs" | cut -d' ' -f1)
if [ "$BASE_SHA_BEFORE" = "$BASE_SHA_AFTER" ]; then
    say "base image unchanged (FS-003 ok)"
else
    say "BASE IMAGE CHANGED DURING RUN -- FS-003 VIOLATED"
    exit 1
fi

case $RRC in
    0) say "export ok" ;;
    3) say "receiver aborted the stream on a policy violation (see log above)" ;;
    4) say "guest never connected to the output channel" ;;
    *) say "receiver exited $RRC" ;;
esac

say "artifacts: $QUARANTINE"
ls -l "$QUARANTINE" >&2 || true

# RES-008. Per-run bounds all hold; what nothing bounds is the number of runs.
# Reported after the run so the figure includes what this one just added.
#
# This only ever reports. Auto-pruning quarantined output would be the kind of
# helpfulness that destroys the evidence someone came back for -- retention is an
# operator decision, and the tool's job is to make the number impossible to miss
# rather than to act on it.
QUAR_ROOT="$ROOT/quarantine"
QUAR_BYTES=$(du -sb "$QUAR_ROOT" 2>/dev/null | cut -f1)
QUAR_RUNS=$(find "$QUAR_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
if [ -n "$QUAR_BYTES" ]; then
    QUAR_MB=$((QUAR_BYTES / 1024 / 1024))
    if [ "$QUAR_MB" -ge "$QUARANTINE_WARN_MB" ]; then
        say "RES-008 WARNING: quarantine holds ${QUAR_MB} MB across ${QUAR_RUNS} run(s),"
        say "                 at or over the ${QUARANTINE_WARN_MB} MB mark. Nothing bounds"
        say "                 growth across runs; prune what you no longer need:"
        say "                   find quarantine -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} +"
        say "                 (that form leaves the exclusion markers in place)"
    else
        say "quarantine total: ${QUAR_MB} MB across ${QUAR_RUNS} run(s) (RES-008)"
    fi
fi

# 0 = nominal, 3 = the receiver enforced a cap (the boundary did its job and
# the caller should know), other = receiver malfunction.
case $RRC in
    0|4) exit 0 ;;
    3)   exit 3 ;;
    *)   exit 0 ;;
esac
