"""OUT-002 measurement -- decode and score.

Takes what the host transmitted (schedule.txt, from modulate) and what the guest
observed (latency.txt, from probe), and answers one question: at this symbol
period, how many bits per second get through, and at what error rate?

The two clocks share no origin -- the guest's series starts when the probe
starts, the host's when modulate starts -- so the offset is unknown. It is,
however, constant, so we search for it and report the best alignment. A decoder
that could not find an alignment would be indistinguishable from a channel with
no capacity, which is exactly the confusion this has to avoid: the null result
must be a measured null, not a failure to look.
"""
import argparse
import sys


def load_schedule(path):
    period_ms, rows = None, []
    for line in open(path):
        if line.startswith("# period_ms"):
            period_ms = float(line.split()[2])
        elif not line.startswith("#"):
            t, bit = line.split()
            rows.append((float(t), int(bit)))
    return period_ms, rows


def load_latency(path):
    out = []
    for line in open(path):
        if not line.startswith("#"):
            t, lat = line.split()
            out.append((int(t) / 1e6, int(lat) / 1e6))  # seconds
    return out


def decode(samples, period, nbits, offset, threshold):
    """Classify each symbol window as stalled (0) or draining (1).

    A window is stalled if any write in it blocked for more than `threshold`.
    Max, not mean: one blocked write is the whole signal, and averaging it
    against hundreds of instant writes in the same window buries it.
    """
    bits, covered = [], 0
    for i in range(nbits):
        lo, hi = offset + i * period, offset + (i + 1) * period
        window = [lat for (t, lat) in samples if lo <= t < hi]
        if not window:
            bits.append(None)
            continue
        covered += 1
        bits.append(0 if max(window) > threshold else 1)
    return bits, covered


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--schedule", required=True)
    ap.add_argument("--latency", required=True)
    ap.add_argument("--threshold-ms", type=float, default=0.0,
                    help="0 = derive from the noise floor")
    args = ap.parse_args()

    period_ms, sched = load_schedule(args.schedule)
    samples = load_latency(args.latency)
    if not sched or not samples:
        print("empty input", file=sys.stderr)
        return 2
    period = period_ms / 1000.0
    sent = [b for _, b in sched]

    lats = sorted(lat for _, lat in samples)
    p99 = lats[int(len(lats) * 0.99)]
    noise = lats[-1] if len(lats) < 100 else p99
    threshold = args.threshold_ms / 1000.0 if args.threshold_ms else max(noise * 4, 0.001)

    span = samples[-1][0]
    print(f"symbol period   : {period_ms:.1f} ms")
    print(f"carrier span    : {span:.2f} s, {len(samples)} write samples "
          f"({span / len(samples) * 1000:.3f} ms/sample)")
    print(f"noise floor p99 : {p99 * 1000:.3f} ms -> threshold {threshold * 1000:.3f} ms")

    # Search the unknown clock offset. Step at a fraction of a symbol so we do
    # not skip past the true alignment.
    best = None
    step = period / 8
    off = -period * 2
    while off < span:
        nbits = min(len(sent), int((span - max(off, 0)) / period))
        if nbits >= 8:
            got, covered = decode(samples, period, nbits, off, threshold)
            pairs = [(a, b) for a, b in zip(sent, got) if b is not None]
            if len(pairs) >= 8:
                errs = sum(1 for a, b in pairs if a != b)
                ber = errs / len(pairs)
                if best is None or ber < best[0]:
                    best = (ber, errs, len(pairs), off)
        off += step

    if best is None:
        print("no alignment had enough overlap to score")
        return 1

    ber, errs, n, off = best
    print(f"best alignment  : offset {off:+.3f} s, {n} symbols scored")
    print(f"bit errors      : {errs}/{n}  BER {ber * 100:.1f}%")
    gross = 1000.0 / period_ms
    print(f"gross rate      : {gross:.1f} bits/s")
    if ber < 0.01:
        print(f"=> CLEAN at this period. Effective: ~{gross:.0f} bits/s")
    elif ber < 0.25:
        print(f"=> degraded but far above chance. Effective: <{gross:.0f} bits/s")
    else:
        print("=> at or near chance; this period is past the channel's limit")
    return 0


if __name__ == "__main__":
    sys.exit(main())
