#!/usr/bin/env python3
"""Adversarial ingest corpus (ING-001, ING-002, AUD-002).

ironveil-ingest is the stage that finally PARSES guest output and is therefore
the most dangerous program in the project. It is a resource-safety and
path-safety control, not a memory-safety boundary.

Same two rules as tests/adversarial/frames: a must-accept half so the corpus can
pass, and a minimum case count so a corpus that built nothing cannot sweep.
"""

import io
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
INGEST = os.path.join(ROOT, "bin", "ironveil-ingest")

RC_OK, RC_REFUSED, RC_USAGE = 0, 3, 2


def zbytes(members, compress=zipfile.ZIP_DEFLATED):
    b = io.BytesIO()
    with zipfile.ZipFile(b, "w", compress) as z:
        for n, d in members.items():
            z.writestr(n, d)
    return b.getvalue()


def tbytes(members):
    b = io.BytesIO()
    with tarfile.open(fileobj=b, mode="w") as t:
        for n, d in members.items():
            i = tarfile.TarInfo(n)
            i.size = len(d)
            t.addfile(i, io.BytesIO(d))
    return b.getvalue()


class Case:
    def __init__(self, cid, stmt, blob, expect_rc, expect_err=None,
                 note=None, args=(), check=None):
        self.cid, self.stmt, self.blob = cid, stmt, blob
        self.expect_rc, self.expect_err = expect_rc, expect_err
        self.note, self.args, self.check = note, list(args), check


def run_case(c):
    tmp = tempfile.mkdtemp(prefix="ivingest.")
    src = os.path.join(tmp, "sample.bin")
    dest = os.path.join(tmp, "out")
    try:
        with open(src, "wb") as fh:
            fh.write(c.blob)
        p = subprocess.run([INGEST, src, dest] + c.args,
                           capture_output=True, timeout=120)
        rc, err = p.returncode, p.stderr.decode(errors="replace")
        if rc != c.expect_rc:
            tail = err.strip().splitlines()[-1:] or [""]
            return False, f"exit {rc}, wanted {c.expect_rc} | {tail[0]}"
        if c.expect_err and c.expect_err not in err:
            tail = err.strip().splitlines()[-1:] or [""]
            return False, f"wanted {c.expect_err!r}, got: {tail[0]}"
        # A refusal must remove its partial output, never leave it for a later
        # stage to find and treat as complete.
        if rc == RC_REFUSED and os.path.exists(dest):
            return False, "refused but left partial output behind"
        if c.check:
            return c.check(dest, err)
        return True, ""
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def check_commingled(dest, err):
    """The basename-collision finding, pinned as current behaviour."""
    hits = []
    for root, _, files in os.walk(dest):
        for f in files:
            if f.startswith("from_"):
                hits.append(os.path.join(root, f))
    dirs = {os.path.dirname(h) for h in hits}
    if len(hits) != 2:
        return False, f"expected both inner members, found {len(hits)}"
    if len(dirs) != 1:
        return False, "archives were separated -- behaviour changed, update the finding"
    return True, ""


def build():
    C = []
    A = C.append

    # ---------------------------------------------------------- must accept --
    A(Case("accept/benign-zip", "ING-001",
           zbytes({"report.txt": b"clean\n" * 100}), RC_OK))
    A(Case("accept/benign-tar", "ING-001",
           tbytes({"notes.txt": b"clean\n" * 100}), RC_OK))
    A(Case("accept/nested-within-depth", "ING-001",
           zbytes({"l1.zip": zbytes({"l2.zip": zbytes({"leaf.txt": b"deep\n"})})},
                  compress=zipfile.ZIP_STORED), RC_OK))

    # ---------------------------------------------------------- must refuse --
    A(Case("bomb/ratio", "ING-001",
           zbytes({"b.dat": b"\0" * (64 * 1024 * 1024)}), RC_REFUSED,
           args=["--max-output-bytes", "20000000"]))
    A(Case("bomb/absolute-cap", "ING-001",
           zbytes({"b.dat": b"\0" * (8 * 1024 * 1024)}, compress=zipfile.ZIP_STORED),
           RC_REFUSED, "exceeded cap", args=["--max-output-bytes", "1000000",
                                             "--max-ratio", "100000"]))
    A(Case("bomb/file-count", "ING-001",
           zbytes({f"f{i}.txt": b"x" for i in range(50)}), RC_REFUSED,
           "file count exceeded", args=["--max-files", "10"]))

    A(Case("path/traversal-zip", "ING-002",
           zbytes({"../../../../etc/ironveil-pwned": b"escaped\n"}), RC_REFUSED))
    A(Case("path/absolute-zip", "ING-002",
           zbytes({"/etc/ironveil-pwned": b"escaped\n"}), RC_REFUSED))
    A(Case("path/backslash-traversal", "ING-002",
           zbytes({"..\\..\\ironveil-pwned": b"escaped\n"}), RC_REFUSED))
    A(Case("path/drive-qualified", "ING-002",
           zbytes({"C:evil.txt": b"escaped\n"}), RC_REFUSED))

    # Non-regular members. tarfile carries real symlink/hardlink types; zip
    # encodes the unix mode in external_attr instead.
    sym = io.BytesIO()
    with tarfile.open(fileobj=sym, mode="w") as t:
        i = tarfile.TarInfo("shadow"); i.type = tarfile.SYMTYPE
        i.linkname = "/etc/shadow"; t.addfile(i)
    A(Case("nonregular/tar-symlink", "ING-002", sym.getvalue(), RC_REFUSED,
           "non-regular member"))

    hard = io.BytesIO()
    with tarfile.open(fileobj=hard, mode="w") as t:
        d = b"data\n"; i = tarfile.TarInfo("real"); i.size = len(d)
        t.addfile(i, io.BytesIO(d))
        l = tarfile.TarInfo("link"); l.type = tarfile.LNKTYPE
        l.linkname = "real"; t.addfile(l)
    A(Case("nonregular/tar-hardlink", "ING-002", hard.getvalue(), RC_REFUSED,
           "non-regular member"))

    fifo = io.BytesIO()
    with tarfile.open(fileobj=fifo, mode="w") as t:
        i = tarfile.TarInfo("pipe"); i.type = tarfile.FIFOTYPE; t.addfile(i)
    A(Case("nonregular/tar-fifo", "ING-002", fifo.getvalue(), RC_REFUSED,
           "non-regular member"))

    zsym = io.BytesIO()
    with zipfile.ZipFile(zsym, "w") as z:
        zi = zipfile.ZipInfo("link")
        zi.external_attr = (0o120777 << 16)  # S_IFLNK
        z.writestr(zi, "/etc/shadow")
    A(Case("nonregular/zip-symlink-mode", "ING-002", zsym.getvalue(),
           RC_REFUSED, "non-regular member"))

    A(Case("malformed/truncated-zip", "ING-001",
           zbytes({"a.txt": b"x" * 10000}, compress=zipfile.ZIP_STORED)[:500],
           RC_REFUSED, "malformed archive"))

    # ------------------------------------------------------------- pinned ----
    A(Case("pinned/basename-collision", "AUD-002",
           zbytes({"a/m.zip": zbytes({"from_a.txt": b"FROM a/m.zip\n"}),
                   "b/m.zip": zbytes({"from_b.txt": b"FROM b/m.zip\n"})},
                  compress=zipfile.ZIP_STORED),
           RC_OK, check=check_commingled,
           note="maybe_recurse() derives the nested output directory from "
                "basename ALONE -- os.path.basename(path) + '.dN' -- then calls "
                "makedirs(..., exist_ok=True). Two archives sharing a basename in "
                "different directories of the same parent expand into ONE "
                "directory and commingle, exit 0, with the log printing the same "
                "'nested zip at depth 1: m.zip' line twice. Not an escape: "
                "safe_member_path still confines every member under dest. It is an "
                "ATTRIBUTION failure -- output cannot say which archive a file came "
                "from -- and the same class as AUD-002, a guest-chosen string "
                "sharing a namespace. It also gives a denial-of-analysis: planting "
                "a colliding member name makes O_EXCL refuse a benign archive."))
    return C


def main():
    if not os.access(INGEST, os.X_OK):
        print(f"ingest not executable: {INGEST}", file=sys.stderr)
        return 2
    cases = build()
    accepts = [c for c in cases if c.expect_rc == RC_OK]
    if len(cases) < 15 or len(accepts) < 3:
        print(f"corpus too small: {len(cases)} cases ({len(accepts)} accept); "
              f"this run would be vacuous", file=sys.stderr)
        return 2

    print(f"\033[1mingest corpus: {len(cases)} cases "
          f"({len(accepts)} must-accept, {len(cases) - len(accepts)} must-refuse)\033[0m")
    failed, notes = 0, []
    for c in cases:
        ok, detail = run_case(c)
        if ok:
            print(f"  \033[32mPASS\033[0m  {c.stmt:<8} {c.cid}")
        else:
            print(f"  \033[31mFAIL\033[0m  {c.stmt:<8} {c.cid}: {detail}")
            failed += 1
        if c.note:
            notes.append((c.cid, c.note))
    print(f"\n{len(cases) - failed} passed, {failed} failed")
    if notes:
        print("\n\033[1mFINDINGS -- pinned behaviour, no decision taken:\033[0m")
        for cid, note in notes:
            print(f"  * {cid}\n      {note}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
