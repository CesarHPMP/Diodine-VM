#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 César Henrique Policarpo de Melo
# Diodine VM Phase 2 adversarial suite.
#
# tests/run-checks says of itself that it is NOT this: its payloads are
# cooperative probes confirming the boundary is configured as claimed. This is
# where hostile inputs try to break it.
#
# Rules this suite is built to (NEXT.md, "Rules for Phase 2 tests"):
#
#   1. Every check has been demonstrated FAILING before being trusted to pass.
#      Each corpus carries a must-accept half for exactly that reason -- a suite
#      that only ever saw hostile input would sweep clean even if the component
#      refused everything, including a broken one.
#   2. Every upper bound has a lower bound. Each corpus asserts a minimum case
#      count and refuses to report success below it, so a corpus that silently
#      built nothing cannot pass.
#   4. Nothing here is piped into anything. The exit status is the result --
#      piping run-checks into tail once masked a failing status for a whole
#      session.
#
# Every case names the policy statement it attacks. A new attack with no
# statement means the statement gets added to policy.yaml FIRST.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cd "$ROOT"

# Default is everything. A caller may name a subset -- `run frames ingest` -- and
# CI does exactly that, because `exhaustion` drives real VMs and needs KVM, a
# loaded AppArmor profile and cgroup delegation, none of which a hosted runner
# has.
#
# Selection is EXPLICIT rather than auto-detected on purpose. A runner that
# noticed KVM was missing and quietly skipped the VM half would report "all
# suites passed" for a third of the work, which is the reassuring-failure shape
# this project keeps finding. If a named suite cannot run, it fails.
SUITES=(frames ingest confinement exhaustion)
[ "$#" -gt 0 ] && SUITES=("$@")
RAN=0; FAILED=0

printf '\033[1mDiodine VM adversarial suite\033[0m (%s)\n' "${SUITES[*]}"

for s in "${SUITES[@]}"; do
    printf '\n\033[1m=== %s ===\033[0m\n' "$s"
    if [ ! -x "$HERE/$s" ]; then
        printf '  \033[31mFAIL\033[0m  suite %s is missing or not executable\n' "$s"
        FAILED=$((FAILED + 1))
        continue
    fi
    "$HERE/$s"
    rc=$?
    RAN=$((RAN + 1))
    [ "$rc" -ne 0 ] && FAILED=$((FAILED + 1))
done

# Lower bound on the suite runner itself, for the same reason each corpus has
# one. A runner that found no suites and reported success would be the most
# reassuring failure in the whole project.
printf '\n\033[1m----------------------------------------\033[0m\n'
if [ "$RAN" -lt "${#SUITES[@]}" ]; then
    printf '\033[31monly %d of %d suites ran; this result is not evidence\033[0m\n' \
           "$RAN" "${#SUITES[@]}"
    exit 2
fi

if [ "$FAILED" -eq 0 ]; then
    printf '\033[1m%d suites, all passed\033[0m\n' "$RAN"
    exit 0
fi
printf '\033[31m%d of %d suites failed\033[0m\n' "$FAILED" "$RAN"
exit 1
