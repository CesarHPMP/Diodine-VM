"""Attack the confinement profile directly -- the hypervisor boundary's host half.

The containment claim -- a compromised guest cannot reach the host -- has two
links. guest -> QEMU needs a hypervisor 0-day and is inherited platform risk,
out of scope. QEMU -> host is the AppArmor profile's entire job, and it is
testable now: if the profile is full of holes, the claim is hollow no matter how
good KVM is. Nothing had tested it until this corpus.

Method: run a probe UNDER the profile with `aa-exec -p diodine-qemu`, exactly the
way VMM-002 and AUD-004 already probe by attempted use rather than by reading
configuration. Each case is what a compromised QEMU would try; the profile must
refuse the host-sensitive ones and permit only the few it genuinely needs.

Each case is a DIRECT command, never `sh -c "..."`. That is not stylistic. The
aa-exec ENTRY exec is exempt, but a shell wrapper then needs a SECOND exec to run
its helper (cat, head, mkdir), and the profile denies every exec it did not name.
A `sh -c "cat /etc/shadow"` case therefore fails to even run cat and reports
"denied" -- for the wrong reason, whether or not /etc/shadow was readable. The
first version of this file did exactly that, and its must-deny half passed
vacuously; the must-allow half is what exposed it. So file access is probed by
running the tool AS the entry (its file access is then what the profile checks),
and writes are probed with dd rather than a shell redirect.

Two-sided, per the Phase 2 rules. A profile that denied EVERYTHING would pass a
corpus of must-deny cases while being unusable, so the must-allow half asserts the
VMM can still reach what it needs to boot. A corpus of only must-deny cases is
also how you fail to notice you have broken the product.

The profile is not the only host-side control on this boundary. AUD-005 has the
launcher copy the guest console out of the VMM's run dir into quarantine, and that
copy -- run unconfined -- is a confused-deputy target: a compromised VMM can swap
its console file for a symlink at a host secret the profile forbade it to read.
So a second phase (promotion_probe) drives the real bin/diodine-promote-console
helper with that attack and with an honest file, asserting the secret is never
dereferenced and an honest console still promotes. It runs the actual helper, not
a copy of its logic, so the test and the code cannot drift.

Requires the profile LOADED (sudo policy/apparmor/install), like the exhaustion
corpus requires KVM. It is not in the CI subset for that reason.
"""

import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
os.chdir(ROOT)

PROFILE = "diodine-qemu"


def confined(argv):
    """True if the command SUCCEEDED under the profile."""
    try:
        r = subprocess.run(["aa-exec", "-p", PROFILE, "--"] + argv,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=15)
        return r.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def profile_loaded():
    return confined(["/bin/true"])


class Case:
    def __init__(self, cid, stmt, want, argv, note=None):
        self.cid, self.stmt, self.want, self.argv = cid, stmt, want, argv
        self.note = note


def read_(path):
    # cat AS the entry: its own read is what the profile checks.
    return ["cat", path]


def write_(path):
    # dd AS the entry, O_WRONLY|O_CREAT without O_TRUNC, one byte. Proves the
    # profile grants a WRITE open on this path.
    return ["dd", "if=/dev/zero", f"of={path}", "bs=1", "count=1", "conv=notrunc"]


def build(target_run):
    home = os.path.expanduser("~")
    clog = os.path.join(target_run, "console.log")
    manifest = os.path.join(target_run, "MANIFEST.json")

    C = []
    A = C.append

    # ---- must DENY: host confidentiality -----------------------------------
    A(Case("secrets/etc-shadow", "VMM-002", "deny", read_("/etc/shadow")))
    A(Case("secrets/etc-passwd", "VMM-002", "deny", read_("/etc/passwd")))
    A(Case("secrets/ssh-key", "VMM-002", "deny", read_(f"{home}/.ssh/id_rsa")))
    A(Case("secrets/bash-history", "VMM-002", "deny", read_(f"{home}/.bash_history")))

    # ---- must DENY: integrity of the source tree (persistence) --------------
    A(Case("persist/launcher", "TCB-001", "deny", write_("bin/diodine-run")))
    A(Case("persist/payload", "TCB-001", "deny", write_("tests/payloads/probe.sh")))
    A(Case("persist/profile-template", "VMM-002", "deny",
           write_("policy/apparmor/diodine-qemu.in")))

    # ---- must DENY: base image immutability (FS-003) ------------------------
    A(Case("baseimg/write-vmlinuz", "FS-003", "deny", write_("image/base/vmlinuz")))
    A(Case("baseimg/write-initramfs", "FS-003", "deny", write_("image/base/initramfs")))

    # ---- must DENY: cross-run record integrity (AUD-005) --------------------
    # THE finding. A compromised VMM must not be able to write another run's
    # console at all -- the target here is a throwaway run this corpus created,
    # never real output.
    A(Case("crossrun/write-prior-console", "AUD-005", "deny", write_(clog),
           note="a compromised VMM writing a completed run's console log"))
    A(Case("crossrun/read-prior-manifest", "AUD-002", "deny", read_(manifest)))
    A(Case("crossrun/new-file-in-quarantine", "AUD-005", "deny",
           write_("quarantine/EVIL.txt")))
    A(Case("crossrun/mkdir-in-quarantine", "AUD-005", "deny",
           ["mkdir", "quarantine/FAKE-RUN"]))

    # ---- must DENY: reach into processes / the network ---------------------
    A(Case("proc/environ-self", "VMM-001", "deny", read_("/proc/self/environ")))
    # The @{PROC}/@{pid}/... grants are scoped to QEMU's OWN pid. Reading ANOTHER
    # process is a different boundary, and pid 1 is always present: its environ is
    # host secrets and its maps defeat ASLR. Both must be refused.
    A(Case("proc/environ-init", "VMM-001", "deny", read_("/proc/1/environ")))
    A(Case("proc/maps-init", "VMM-001", "deny", read_("/proc/1/maps")))
    if shutil.which("bash"):
        # bash AS the entry; /dev/tcp is internal to bash, so no second exec, and
        # the connect is what `deny network` must stop.
        A(Case("net/open-socket", "NET-002", "deny",
               ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/22"]))

    # ---- must ALLOW: what the VMM genuinely needs to boot ------------------
    A(Case("need/read-urandom", "DEV-005", "allow",
           ["dd", "if=/dev/urandom", "of=/dev/null", "bs=1", "count=1"]))
    A(Case("need/read-base-vmlinuz", "FS-003", "allow",
           ["dd", "if=image/base/vmlinuz", "of=/dev/null", "bs=1", "count=1"]))
    A(Case("need/read-base-initramfs", "FS-003", "allow",
           ["dd", "if=image/base/initramfs", "of=/dev/null", "bs=1", "count=1"]))
    A(Case("need/create-own-runtime-dir", "AUD-005", "allow",
           ["mkdir", "-p", f"/run/user/{os.getuid()}/diodine/probe.{os.getpid()}"]))
    return C


def run(c):
    got = "allow" if confined(c.argv) else "deny"
    return got == c.want, got


def promotion_probe():
    """The boundary's OTHER host-side control: the console-promotion helper.

    The profile denies the VMM every host secret directly. AUD-005 then made the
    launcher copy the guest console out of the VMM's run dir into quarantine --
    and that copy, run unconfined, is a confused deputy. QEMU has rw on its run
    dir, so a compromised VMM can replace the console file with a SYMLINK at a
    host secret the profile forbade it to read, and a naive copy would dereference
    it on the VMM's behalf: the launcher reading, with its own access, exactly what
    the profile's deny was there to stop. This exercises the real helper, not a
    copy of its logic, so the two cannot drift.

    Two-sided like the profile probe: a symlink must be refused with the secret
    never dereferenced, and an honest regular file must still be promoted.
    Returns the number of failures and prints each verdict.
    """
    helper = os.path.join(ROOT, "bin", "diodine-promote-console")
    if not os.access(helper, os.X_OK):
        print("  \033[31mFAIL\033[0m  AUD-005  diodine-promote-console missing "
              "or not executable")
        return 1

    print("\n\033[1mpromotion path: bin/diodine-promote-console as a confused "
          "deputy\033[0m")
    fails = 0
    work = tempfile.mkdtemp(prefix="PROMOTE-PROBE.", dir="quarantine")
    try:
        secret = os.path.join(work, "host-secret")
        marker = "HOST-SECRET-MUST-NEVER-REACH-QUARANTINE"
        with open(secret, "w") as fh:
            fh.write(marker + "\n")

        # --- must REFUSE: a symlink standing in for the console -------------
        link = os.path.join(work, "run-console.symlink")
        os.symlink(secret, link)
        dst = os.path.join(work, "promoted.symlink")
        rc = subprocess.run([helper, link, dst]).returncode
        leaked = os.path.exists(dst) and marker in open(dst).read()
        if rc != 0 and not leaked:
            print("  \033[32mPASS\033[0m  AUD-005  promote/refuse-symlink")
        else:
            print(f"  \033[31mFAIL\033[0m  AUD-005  promote/refuse-symlink "
                  f"-- rc={rc}, secret {'LEAKED' if leaked else 'not leaked'}")
            fails += 1

        # --- must ALLOW: an honest regular console --------------------------
        good = os.path.join(work, "run-console.real")
        with open(good, "w") as fh:
            fh.write("[diodine-guest] real console line\n")
        dst2 = os.path.join(work, "promoted.real")
        rc = subprocess.run([helper, good, dst2]).returncode
        promoted = os.path.exists(dst2) and \
            open(dst2).read() == open(good).read()
        if rc == 0 and promoted:
            print("  \033[32mPASS\033[0m  AUD-005  promote/allow-regular-file")
        else:
            print(f"  \033[31mFAIL\033[0m  AUD-005  promote/allow-regular-file "
                  f"-- rc={rc}, promoted={promoted}")
            fails += 1
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return fails


def main():
    if shutil.which("aa-exec") is None:
        print("aa-exec not present; cannot probe the profile", file=sys.stderr)
        return 2
    if not profile_loaded():
        print(f"profile {PROFILE} is not loaded; run: sudo policy/apparmor/install",
              file=sys.stderr)
        return 2

    # A throwaway run to attack, so no real output is ever touched. Created with
    # normal (unconfined) file ops, exactly as the launcher would author a run.
    os.makedirs("quarantine", exist_ok=True)
    target = tempfile.mkdtemp(prefix="CONFINEMENT-PROBE.", dir="quarantine")
    with open(os.path.join(target, "console.log"), "w") as fh:
        fh.write("REAL PRIOR-RUN CONSOLE -- must survive\n")
    with open(os.path.join(target, "MANIFEST.json"), "w") as fh:
        fh.write('{"real": true}\n')
    baseline = open(os.path.join(target, "console.log")).read()

    cases = build(target)
    denies = [c for c in cases if c.want == "deny"]
    allows = [c for c in cases if c.want == "allow"]
    # Lower bounds: a corpus that lost either half is not evidence.
    if len(denies) < 10 or len(allows) < 4:
        print(f"corpus too small: {len(denies)} deny, {len(allows)} allow; vacuous",
              file=sys.stderr)
        return 2

    print(f"\033[1mconfinement corpus: {len(cases)} cases "
          f"({len(denies)} must-deny, {len(allows)} must-allow) vs the live "
          f"{PROFILE} profile\033[0m")

    failed, notes = 0, []
    for c in cases:
        ok, got = run(c)
        tag = "\033[32mPASS\033[0m" if ok else "\033[31mFAIL\033[0m"
        arrow = "refused" if c.want == "deny" else "permitted"
        print(f"  {tag}  {c.stmt:<8} {c.cid}")
        if not ok:
            print(f"        wanted {c.want}, profile {got.upper()} it "
                  f"-- must be {arrow}")
            failed += 1
        if c.note and not ok:
            notes.append((c.cid, c.note))

    # A denied write must have changed nothing. If the target console differs
    # from its baseline, some case wrote to it and the deny was not real.
    if open(os.path.join(target, "console.log")).read() != baseline:
        print("  \033[31mFAIL\033[0m  AUD-005  the throwaway console was modified "
              "despite the deny verdicts")
        failed += 1
    # Clean up: the throwaway run and anything a partial write left behind.
    shutil.rmtree(target, ignore_errors=True)
    for junk in ("quarantine/EVIL.txt", "quarantine/FAKE-RUN"):
        if os.path.exists(junk):
            (shutil.rmtree if os.path.isdir(junk) else os.unlink)(junk)

    # The second host-side control on the same boundary: the promotion helper.
    total = len(cases) + 2
    failed += promotion_probe()

    print(f"\n{total - failed} passed, {failed} failed")
    if notes:
        print("\n\033[1mwhat the failures mean:\033[0m")
        for cid, n in notes:
            print(f"  * {cid}: {n}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
