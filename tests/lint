# Diodine VM static hygiene.
#
# Everything here is checkable WITHOUT a VM, without root, and without the
# AppArmor profile loaded -- which is precisely the set CI can run. It verifies
# that the tree parses, builds, carries its licence, and that the confinement
# profile still compiles, and nothing about whether the boundary holds once
# loaded. tests/run-checks and tests/adversarial/confinement do that, and cannot
# run here.
#
# Built to the same rule as the rest of Phase 2: every count has a LOWER bound.
# A glob that silently matches nothing would otherwise sweep clean, which is the
# single most common way a check in this project has failed toward a reassuring
# answer.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"

PASS=0; FAIL=0
ok()    { printf '  \033[32mPASS\033[0m  %-9s %s\n' "$1" "$2"; PASS=$((PASS+1)); }
bad()   { printf '  \033[31mFAIL\033[0m  %-9s %s\n' "$1" "$2"; FAIL=$((FAIL+1)); }
head_() { printf '\n\033[1m%s\033[0m\n' "$1"; }

printf '\033[1mDiodine VM static hygiene\033[0m\n'

# Source files, by interpreter. Derived from git rather than a hand-kept list,
# so a new file is covered the day it is added.
mapfile -t SH_FILES < <(git ls-files | while read -r f; do
    head -1 "$f" 2>/dev/null | grep -q '^#!.*\(bash\|sh\)$' && echo "$f"; done)
mapfile -t PY_FILES < <(git ls-files | while read -r f; do
    head -1 "$f" 2>/dev/null | grep -q '^#!.*python3$' && echo "$f"; done)
mapfile -t SRC_FILES < <(git ls-files | grep -vE '\.md$|^LICENSE$|^\.gitignore$')

head_ "A. Lower bounds on this harness itself"
if [ "${#SH_FILES[@]}" -ge 10 ]; then
    ok "LINT" "found ${#SH_FILES[@]} shell scripts to check"
else
    bad "LINT" "found only ${#SH_FILES[@]} shell scripts; this run would be vacuous"
fi
if [ "${#PY_FILES[@]}" -ge 5 ]; then
    ok "LINT" "found ${#PY_FILES[@]} python scripts to check"
else
    bad "LINT" "found only ${#PY_FILES[@]} python scripts; this run would be vacuous"
fi

head_ "B. Everything parses"
n=0
for f in "${SH_FILES[@]}"; do
    bash -n "$f" 2>/dev/null || { bad "LINT" "shell syntax error: $f"; continue; }
    n=$((n+1))
done
[ "$n" -eq "${#SH_FILES[@]}" ] && ok "LINT" "all $n shell scripts parse"

n=0
for f in "${PY_FILES[@]}"; do
    python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$f" 2>/dev/null \
        || { bad "LINT" "python syntax error: $f"; continue; }
    n=$((n+1))
done
[ "$n" -eq "${#PY_FILES[@]}" ] && ok "LINT" "all $n python scripts parse"

if command -v gcc >/dev/null 2>&1; then
    if gcc -static -O2 -o /dev/null tests/out002/probe.c 2>/dev/null; then
        ok "LINT" "tests/out002/probe.c builds"
    else
        bad "LINT" "tests/out002/probe.c does not build"
    fi
else
    bad "LINT" "gcc absent; the OUT-002 probe was not built"
fi

head_ "C. Policy file is readable by its own tooling"
NIDS=$(grep -cE '^  - id: [A-Z]' policy/policy.yaml)
if [ "$NIDS" -ge 20 ]; then
    ok "POLICY" "policy.yaml parses to $NIDS statements"
else
    bad "POLICY" "policy.yaml parsed to $NIDS statements; the parser has drifted"
fi
DUPES=$(grep -oE '^  - id: [A-Z0-9-]+' policy/policy.yaml | sort | uniq -d)
if [ -z "$DUPES" ]; then
    ok "POLICY" "no duplicate statement ids"
else
    bad "POLICY" "duplicate statement ids: $(echo $DUPES | tr '\n' ' ')"
fi

head_ "D. Licence notices (GPL-3.0-or-later)"
# Read the notice from the file HEADER only, never from the whole file. Scanning
# whole files made this harness match its OWN grep pattern the moment it was
# committed and entered git ls-files: the literal identifier regex in its source
# was extracted as though it were a licence tag, and CI failed with
# "inconsistent licence identifiers: SPDX-License-Identifier: [^". That is the
# same defect as Phase 1's pgrep -f matching the shell doing the searching, and
# the same one run-checks' AUD-003 already sidesteps by assembling its fabricated
# ids from variables so the literals never appear in the harness it reads.
#
# Header-scoping is also the stricter claim: a licence notice belongs at the top
# of a file, not merely somewhere inside it.
spdx_of() { head -5 "$1" | grep -oE 'SPDX-License-Identifier:[[:space:]]*[A-Za-z0-9.+-]+' \
                         | head -1 | sed 's/.*:[[:space:]]*//'; }

MISSING=""; WRONG=""
for f in "${SRC_FILES[@]}"; do
    id=$(spdx_of "$f")
    if [ -z "$id" ]; then MISSING="$MISSING $f"
    elif [ "$id" != "GPL-3.0-or-later" ]; then WRONG="$WRONG $f($id)"; fi
done
if [ -z "$MISSING" ]; then
    ok "LICENSE" "all ${#SRC_FILES[@]} source files carry an SPDX identifier in their header"
else
    bad "LICENSE" "no SPDX identifier in:$MISSING"
fi
if [ -z "$WRONG" ]; then
    ok "LICENSE" "every identifier reads GPL-3.0-or-later"
else
    bad "LICENSE" "inconsistent licence identifiers:$WRONG"
fi
if [ -s LICENSE ] && head -2 LICENSE | grep -q 'GNU GENERAL PUBLIC LICENSE' \
   && grep -q 'Version 3, 29 June 2007' LICENSE; then
    ok "LICENSE" "LICENSE is the GPL v3 text ($(wc -l < LICENSE) lines)"
else
    bad "LICENSE" "LICENSE is missing or is not the GPL v3 text"
fi

head_ "E. Documentation references"
# The docs cite policy statements by id. A renamed or deleted statement leaves a
# reference that still reads authoritative and points at nothing -- and unlike a
# stale count, a reader cannot tell by looking. This is why the check tallies were
# taken OUT of README rather than re-pinned: a number in prose that nothing
# verifies will drift, so either something checks it or it should not be there.
DOCS="README.md NEXT.md BACKLOG.md SECURITY.md diodine.md"
policy_ids_lint() { grep -oE '^  - id: [A-Z][A-Z0-9]*-[0-9]{3}' policy/policy.yaml \
                     | grep -oE '[A-Z][A-Z0-9]*-[0-9]{3}' | sort -u; }
doc_ids_lint()    { grep -ohE '`[A-Z][A-Z0-9]*-[0-9]{3}`' $DOCS 2>/dev/null \
                     | tr -d '`' | sort -u; }

NPOL=$(policy_ids_lint | wc -l)
NDOC=$(doc_ids_lint | wc -l)
if [ "$NPOL" -ge 20 ] && [ "$NDOC" -ge 10 ]; then
    ok "DOCS" "$NDOC statement ids cited across the docs, $NPOL defined in policy"
else
    bad "DOCS" "parsed $NPOL policy ids and $NDOC doc ids; this check is vacuous"
fi

DANGLING=$(comm -13 <(policy_ids_lint) <(doc_ids_lint))
if [ -z "$DANGLING" ]; then
    ok "DOCS" "every statement id cited in the docs exists in policy.yaml"
else
    bad "DOCS" "docs cite statements that do not exist: $(echo $DANGLING | tr '\n' ' ')"
fi

head_ "F. Confinement profile compiles"
# The profile is the entire VMM->host boundary (VMM-002), but a syntax error in
# it surfaced nowhere until `sudo policy/apparmor/install` -- root-only, and off
# the CI path entirely, so a typo could sit on main looking fine. apparmor_parser
# -Q compiles the profile fully WITHOUT loading it into the kernel, which needs
# neither root nor the profile to be active, so it belongs here with the rest of
# what CI can run. @DIODINE_ROOT@ is substituted first (the raw template is not a
# valid path), and the cache is redirected to a temp dir because the default
# /var/cache/apparmor is not writable unprivileged.
PROF_TMPL=policy/apparmor/diodine-qemu.in
if [ ! -f "$PROF_TMPL" ]; then
    bad "PROFILE" "profile template missing: $PROF_TMPL"
elif command -v apparmor_parser >/dev/null 2>&1; then
    ptmp=$(mktemp); pcache=$(mktemp -d)
    sed 's|@DIODINE_ROOT@|/nonexistent/diodine-lint|g' "$PROF_TMPL" > "$ptmp"
    if perr=$(apparmor_parser -Q --cache-loc="$pcache" "$ptmp" 2>&1); then
        ok "PROFILE" "diodine-qemu.in compiles (apparmor_parser -Q, no kernel load)"
    else
        bad "PROFILE" "diodine-qemu.in fails to compile:"
        printf '%s\n' "$perr" | sed 's/^/           /'
    fi
    rm -rf "$ptmp" "$pcache"
else
    # Same stance as the gcc check above: a prerequisite absent is a failure to
    # verify, not a pass. The profile is too central to let its syntax go unchecked
    # silently.
    bad "PROFILE" "apparmor_parser absent; the confinement profile was not syntax-checked"
fi

printf '\n\033[1m%d passed, %d failed\033[0m\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
