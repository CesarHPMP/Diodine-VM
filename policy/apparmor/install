#!/bin/bash
# Load the Ironveil VMM confinement profile. Requires root.
#
#     sudo policy/apparmor/install            # load
#     sudo policy/apparmor/install --remove   # unload
#
# The profile is named (not path-attached), so loading it does not change the
# behaviour of any other QEMU on this machine. Only ironveil-run opts in, via
# aa-exec.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
TEMPLATE="$HERE/ironveil-qemu.in"
TARGET=/etc/apparmor.d/ironveil-qemu

[ "$(id -u)" -eq 0 ] || { echo "must be run as root" >&2; exit 1; }
command -v apparmor_parser >/dev/null || { echo "apparmor_parser not found" >&2; exit 1; }

if [ "${1:-}" = "--remove" ]; then
    [ -f "$TARGET" ] && apparmor_parser -R "$TARGET" || true
    rm -f "$TARGET"
    echo "ironveil-qemu profile removed"
    exit 0
fi

sed "s|@IRONVEIL_ROOT@|$ROOT|g" "$TEMPLATE" > "$TARGET"
chmod 0644 "$TARGET"

echo "loading profile for repository root: $ROOT"
apparmor_parser -r -W "$TARGET"

echo
echo "loaded. verify with:"
echo "    aa-status | grep ironveil"
echo "then re-run ironveil-run; it should report 'confining under ironveil-qemu'."
echo
echo "SECOND PROVISIONING STEP -- denial visibility (AUD-004)."
echo
echo "A loaded profile that silently refuses something is the failure this"
echo "project has already had: the NUMA denial fired on every confined run"
echo "while 26/26 checks passed twice. Reading denials needs journal access,"
echo "and TCB-001 forbids Ironveil a privileged component -- so the operator"
echo "grants it once, out of band, and the launcher stays unprivileged:"
echo
echo "    sudo usermod -aG systemd-journal ${SUDO_USER:-YOUR_USER}"
echo "    # then LOG OUT AND BACK IN -- see below"
echo "    journalctl -k -n1        # must print a real kernel record"
echo
echo "The log-out is not optional and is the step people skip. Supplementary"
echo "groups are fixed at login: usermod does not change any RUNNING process,"
echo "so the shell you typed it in still cannot read the journal, and the next"
echo "run will still record denials.checked=false. 'newgrp' only affects one"
echo "subshell and changes your primary group besides."
echo
echo "Without this, runs still work -- they record that denial checking was"
echo "unavailable, and tests/run-checks FAILS rather than reporting all-green"
echo "while blind."
